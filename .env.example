# API keys. Fill in, save, then run:  python -m compare_agent --check-keys
# Without a key the agent still runs and simply skips that source.

# DataForSEO - traffic per product (Google searches) for Bulgaria + worldwide.
# Use the API login and API password from https://app.dataforseo.com/api-access
# (the API password is NOT your website password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Semrush - optional alternative traffic source (not used by default).
SEMRUSH_API_KEY=

# Google Drive API - optional, only for computers without Google Drive for desktop (python -m top_products).
# Path to a service account's JSON key; the service account must be a Viewer of the shared drive.
GOOGLE_SERVICE_ACCOUNT_FILE=
